# Copiá este archivo a .env.local para probar el envío de inscripciones en local.
# Ver docs/inscripciones-google-sheets.md
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Comando `ask` de la terminal (app/api/ask). Sin esta clave el comando no aparece.
ANTHROPIC_API_KEY=

# Aviso por Telegram de cada inscripción (lib/telegram.ts). Opcional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# La ronda de inversión: Redis REST (Upstash) para compartir votos en Vercel.
# Sin estas variables: archivo local en desarrollo; demo por navegador en Vercel.
# También acepta UPSTASH_REDIS_REST_URL/TOKEN o KV_REST_API_URL/TOKEN de la integración.
INVESTMENTS_REDIS_REST_URL=
INVESTMENTS_REDIS_REST_TOKEN=
